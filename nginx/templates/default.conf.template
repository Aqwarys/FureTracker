# ${DOMAIN} подставляется из .env при старте контейнера nginx
upstream web {
    server web:8000;
}

# HTTP: только проверка Let's Encrypt и редирект на HTTPS
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Включить после того, как убедитесь, что HTTPS работает стабильно
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    charset utf-8;
    # Фото/видео заказов грузятся напрямую в S3, через сервер идут только баннеры акций из админки
    client_max_body_size 75M;

    location / {
        proxy_pass http://web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
