# Скопируйте в .env и заполните. .env не коммитится.

# --- Какие compose-файлы использовать (выберите одну строку) ---
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DJANGO_DEBUG=True
# Через запятую. На проде: baizhigit-mebel.kz,www.baizhigit-mebel.kz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Адрес сайта для личных ссылок клиентов в админке (без слэша в конце)
SITE_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_DB=mebeldata
POSTGRES_USER=admin_mebel
# Только буквы и цифры — пароль подставляется в URL подключения
POSTGRES_PASSWORD=change-me
# Используется только при запуске manage.py без Docker (в Docker адрес базы задаётся в compose)
DATABASE_URL=postgres://admin_mebel:change-me@localhost:5432/mebeldata

# --- Gunicorn (prod) ---
GUNICORN_CMD_ARGS=--workers 3 --timeout 120

# --- Домен и HTTPS (prod) ---
DOMAIN=baizhigit-mebel.kz
CERTBOT_EMAIL=you@example.com

# --- Бэкапы базы (prod) ---
# Формат cron, время UTC. По умолчанию — 1-го числа каждого месяца в 03:00 UTC (08:00 по Астане)
BACKUP_CRON=0 3 1 * *
# Сколько последних дампов хранить, более старые удаляются
BACKUP_KEEP=3

# --- S3-хранилище для фото/видео заказов ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
# Для Cloudflare R2 / PS.kz и т.п.: адрес S3 API провайдера. Для AWS оставить пустым.
AWS_S3_ENDPOINT_URL=
# Публичный домен бакета (постоянные ссылки). Пусто = подписанные ссылки на 1 час, бакет может быть приватным.
AWS_S3_CUSTOM_DOMAIN=
